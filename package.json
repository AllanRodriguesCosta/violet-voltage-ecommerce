{
  "name": "violet-voltage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "seed": "node scripts/seed.js",
    "fotos:conferir": "node scripts/check-photos.js",
    "agente:eval": "node scripts/assistant-eval.js",
    "db:migrate": "node scripts/migrate.js",
    "agente:smoke": "node scripts/assistant-smoke.js",
    "agente:validar-gemini": "node scripts/gemini-validate.js",
    "azure:lb-check": "node scripts/lb-check.js",
    "lb:local": "node scripts/lb-local.js",
    "lb:docker": "docker compose -f infra/local/docker-compose.yml up --build -d",
    "lb:docker:parar": "docker compose -f infra/local/docker-compose.yml down"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "eslint": "^10.11.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.8"
  }
}
