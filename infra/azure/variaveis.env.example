# Copie para infra/azure/variaveis.env (fica fora do git) e preencha. Usado pelos dois roteiros.
# Nunca coloque este arquivo preenchido no GitHub.

# Grupo de recursos: tudo da atividade fica nele, e apagar-tudo.sh remove o grupo inteiro.
RG=violet-voltage-lb
# Região: Azure for Students às vezes só libera algumas (erro "RequestDisallowedByPolicy" -> troque).
LOCATION=eastus2
# Quantas instâncias atrás do balanceador (2 ou 3).
INSTANCES=2

# Valores com caracteres especiais (& $ espaço ; etc.) vão entre aspas simples: DATABASE_URL='...'

# Banco: o mesmo PostgreSQL do Render/Supabase serve (todas as instâncias usam o mesmo banco).
DATABASE_URL=
DATABASE_SSL=true
# Mesmo segredo em todas as instâncias (senão o login feito numa não vale na outra).
# Vazio = o roteiro gera um novo; aí quem já estava logado precisa entrar de novo.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Opcional (assistente com Gemini).
GEMINI_API_KEY=

# --- Caminho A: App Service (balanceador embutido) ---
# Nome único no Azure inteiro: vira https://NOME.azurewebsites.net
APP_NAME=
# B1 é o menor plano que aceita mais de uma instância (F1 gratuito não aceita).
APP_SKU=B1
# Versão do Node no App Service (lista: az webapp list-runtimes --os linux). Mesma do Render e do CI.
APP_RUNTIME=NODE:24-lts

# --- Caminho B: VMs + Azure Load Balancer ---
VM_SIZE=Standard_B1s
REPO_URL=https://github.com/AllanRodriguesCosta/violet-voltage-ecommerce.git
BRANCH=main
