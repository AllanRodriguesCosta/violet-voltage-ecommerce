NODE_ENV=development
PORT=3000
DATABASE_URL=
DATABASE_SSL=true
DATABASE_CA_CERT=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
DEV_MEMORY_STORAGE=false
# Opcional (etapa 25): reforço do assistente com o Gemini gratuito do Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
# Etapa 30: ao iniciar, o servidor cadastra os produtos com foto em seed-assets/catalogo e atualiza
# as fotos que mudaram (nunca preço ou estoque). Use "off" para desligar.
CATALOG_SYNC=
