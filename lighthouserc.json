{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/e2e-server.js",
      "startServerReadyPattern": "e2e na porta",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/catalogo.html",
        "http://127.0.0.1:4173/produto.html?id=demo-001",
        "http://127.0.0.1:4173/ajuda.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.7 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-relatorios" }
  }
}
